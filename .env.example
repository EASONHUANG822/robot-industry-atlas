NEXT_PUBLIC_AMAP_KEY=your_amap_js_api_key
NEXT_PUBLIC_AMAP_SECURITY_CODE=your_amap_security_code
AIRTABLE_TOKEN=pat_xxxxxxxxxxxxx
AIRTABLE_BASE_ID=app_xxxxxxxxxxxxx
# Use the Airtable table name or table ID, for example Applications or tbl_xxxxxxxxxxxxx
AIRTABLE_TABLE_NAME=Applications

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PayPal Checkout
# Use sandbox while testing, live for production.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
# Used to encrypt PayPal return-state data. Set a long random value in production.
PAYMENT_STATE_SECRET=change_me_to_a_long_random_secret

# Alipay Page Pay (电脑网站支付)
# Use sandbox by default (ALIPAY_SANDBOX=true). Set to false for production.
ALIPAY_SANDBOX=true
ALIPAY_APP_ID=your_alipay_app_id
# Merchant RSA2 private key in PKCS1 or PKCS8 format
ALIPAY_PRIVATE_KEY=your_alipay_private_key
# Alipay RSA2 public key
ALIPAY_PUBLIC_KEY=your_alipay_public_key

# UnionPay gateway payment (网关支付)
# Use sandbox by default (UNIONPAY_SANDBOX=true). Set to false for production.
UNIONPAY_SANDBOX=true
UNIONPAY_MER_ID=your_unionpay_merchant_id
# Merchant RSA private key in PEM format (convert from PFX: openssl pkcs12 -in cert.pfx -nocerts -nodes)
UNIONPAY_SIGN_PRIVATE_KEY=your_unionpay_private_key_pem
# Merchant X.509 certificate in PEM format (convert from PFX: openssl pkcs12 -in cert.pfx -clcerts -nokeys)
UNIONPAY_SIGN_CERT=your_unionpay_cert_pem
# UnionPay root certificate in PEM format (from UnionPay developer portal)
UNIONPAY_ROOT_CERT=your_unionpay_root_cert_pem
